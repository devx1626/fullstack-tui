{
  "name": "fullstack-tui",
  "version": "1.0.0",
  "description": "An interactive terminal curriculum (Ink-based TUI) for learning fullstack web development: lessons, hands-on code challenges, debug hunts and capstone projects in a real editor with a built-in browser.",
  "type": "module",
  "bin": {
    "fullstack": "./bin/fullstack.js"
  },
  "scripts": {
    "start": "node bin/fullstack.js",
    "fullstack": "node bin/fullstack.js",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "check": "node tools/check.js",
    "test": "node tools/check.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "verify": "node bin/fullstack.js --verify",
    "list": "node bin/fullstack.js --list",
    "reset": "node bin/fullstack.js --reset",
    "keymap:docs": "node tools/gen-keymap-docs.js"
  },
  "keywords": [
    "tui",
    "terminal",
    "ink",
    "react",
    "learning",
    "fullstack",
    "roadmap",
    "html",
    "css",
    "javascript",
    "typescript",
    "node"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "ink": "^6.8.0",
    "react": "^19.3.0"
  }
}
